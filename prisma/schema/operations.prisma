enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MaintenanceStatus {
  SUBMITTED
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Where a finished repair stands with the tenant. NOT_REQUESTED covers a job that is not finished,
// repairs finished before this step existed, and any job finished while the admin switch
// (SystemSettings.requireTenantRepairConfirmation) was off. It never blocks payment.
enum RepairConfirmationStatus {
  NOT_REQUESTED
  AWAITING_TENANT
  CONFIRMED
  DISPUTED
}

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

// Converted from an enum to a table: unlike a fixed set like Role or
// UserStatus, maintenance categories are the kind of thing an operator
// plausibly wants to add to (e.g. "Pest Control", "Landscaping") without a
// migration. Seed with the original six defaults on first deploy — see the
// seed snippet delivered alongside this schema.
model MaintenanceCategory {
  id        String                @id @default(uuid())
  name      String                @unique
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  requests  MaintenanceRequest[]
  schedules MaintenanceSchedule[]
  vendors   VendorProfile[]
}

model MaintenanceRequest {
  id                      String                   @id @default(uuid())
  unitId                  String
  unit                    Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Null for a work order: a repair the property team raises itself (a vacant or unleased unit, or
  // something they found) rather than one a tenant reported. Everything that reads the tenant must
  // cope with that: there is no tenant to confirm the repair, rate the vendor or be told.
  tenantId                String?
  tenant                  User?                    @relation("TenantMaintenance", fields: [tenantId], references: [id], onDelete: Restrict)
  // Who raised a work order (null when a tenant reported it).
  createdById             String?
  createdBy               User?                    @relation("WorkOrdersRaised", fields: [createdById], references: [id], onDelete: SetNull)
  vendorId                String?
  vendor                  User?                    @relation("VendorJobs", fields: [vendorId], references: [id])
  title                   String
  description             String
  // Nullable, unlike MaintenanceSchedule.category below: a tenant's request
  // often isn't categorized until the AI-triage step classifies it after
  // submission (PRD §5.1 "AI-triaged issue categorization"), so it shouldn't
  // be forced to a value at creation time.
  categoryId              String?
  category                MaintenanceCategory?     @relation(fields: [categoryId], references: [id])
  priority                MaintenancePriority      @default(MEDIUM)
  status                  MaintenanceStatus        @default(SUBMITTED)
  mediaUrls               String[]
  vendorNotes             String?
  completionProofUrl      String?
  // Photos the assigned vendor uploads (gateway URLs, folder maintenance-requests). At least one
  // "after" photo is needed to close the job; "before" photos are optional.
  beforePhotoUrls         String[]                 @default([])
  afterPhotoUrls          String[]                 @default([])
  // Tenant sign-off after completion. A dispute keeps its reason and photos until the vendor
  // finishes the job again, so the vendor and the manager can read them.
  confirmationStatus      RepairConfirmationStatus @default(NOT_REQUESTED)
  confirmationRespondedAt DateTime?
  disputeReason           String?
  disputePhotoUrls        String[]                 @default([])
  // The property team's own sign-off, separate from the vendor completing the job.
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              User?                    @relation("RepairApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  scheduledFor            DateTime?
  completedAt             DateTime?
  costEstimate            Float?
  finalCost               Float?
  invoices                Invoice[]
  vendorPayouts           VendorPayout[]
  conversation            Conversation?
  vendorRating            VendorRating?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([confirmationStatus])
}

model MaintenanceSchedule {
  id              String              @id @default(uuid())
  unitId          String
  unit            Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Optional: a schedule can target a specific piece of Equipment (e.g. service
  // this AC unit every 6 months) or just the unit generally (e.g. routine
  // cleaning) — not every recurring task is equipment-specific.
  equipmentId     String?
  equipment       Equipment?          @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  // Required, unlike MaintenanceRequest.category above: a schedule is
  // deliberately created by staff for a known category, never AI-triaged
  // after the fact.
  categoryId      String
  category        MaintenanceCategory @relation(fields: [categoryId], references: [id])
  frequency       ScheduleFrequency
  nextDueDate     DateTime
  // The day of the month the schedule is meant to fall on (monthly and longer cycles). Adding a
  // month to the 31st must land on the end of a short month and come back to the 31st afterwards,
  // not drift to the 28th for good, so the intended day is kept and each date is worked out from it.
  dayOfMonth      Int?
  lastGeneratedAt DateTime?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([unitId, nextDueDate])
}

// One rating per completed job (PRD §5.4 "Work history & reputation signals").
model VendorRating {
  id                   String             @id @default(uuid())
  maintenanceRequestId String             @unique
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               User               @relation("VendorRatingsReceived", fields: [vendorId], references: [id])
  ratedById            String
  ratedBy              User               @relation("VendorRatingsGiven", fields: [ratedById], references: [id])
  rating               Int
  comment              String?
  createdAt            DateTime           @default(now())

  @@index([vendorId])
}
