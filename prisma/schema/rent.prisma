enum RentStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentFrequency {
  ANNUAL
  BI_ANNUAL
  QUARTERLY
  MONTHLY
}

// Which of Rent's two late-fee fields is actually applied by
// overdueFlagger -- landlord/manager picks one mode per rent, never both
// (avoids ambiguity over whether they'd stack).
enum LateFeeType {
  PERCENTAGE
  FIXED
}

// Covers PRD §5.1 "AI-generated renewal and rent increase notices" and §6.1
// Rent & Document Intelligence ("AI-drafted: Renewal offers, Rent increase
// notices, Default notices" + "Expiration alerts"). Also doubles as the
// escalation-state record for overdue-rent reminders (§6.1 Smart Rent
// Intelligence's reminder -> call -> notice ladder) via PAYMENT_REMINDER,
// rather than adding a separate model just for that.
enum NoticeType {
  RENEWAL_OFFER
  RENT_INCREASE
  DEFAULT_NOTICE
  EXPIRATION_ALERT
  PAYMENT_REMINDER
  TERMINATION_NOTICE
}

enum NoticeStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

model Notice {
  id            String       @id @default(uuid())
  rentId        String
  rent          Rent         @relation(fields: [rentId], references: [id], onDelete: Cascade)
  // Optional precise link for PAYMENT_REMINDER notices about one specific
  // overdue invoice, rather than the rent's rent in general.
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  type          NoticeType
  status        NoticeStatus @default(DRAFT)
  content       String?
  documentUrl   String?
  proposedTerms Json?
  sentAt        DateTime?
  viewedAt      DateTime?
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([rentId, type])
}

enum PaymentReliability {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Rent {
  id                 String              @id @default(uuid())
  unitId             String
  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             User                @relation("TenantRents", fields: [tenantId], references: [id])
  startDate          DateTime
  endDate            DateTime
  /// Amount due per payment CYCLE, not necessarily per calendar month —
  /// the actual period is set by `paymentFrequency` (e.g. an ANNUAL rent's
  /// rentAmount is the full year's rent due at once, not a monthly figure).
  /// Renamed from `monthlyRent`, which was ambiguous once frequencies beyond
  /// MONTHLY were added — see prior schema review.
  rentAmount         Float
  // Contracted recurring service charge, same cycle as rentAmount -- billed
  // as its own InvoiceType.SERVICE_CHARGE line by the rent invoicer worker,
  // not merged into the RENT invoice's amount.
  serviceCharge      Float               @default(0)
  paymentFrequency   PaymentFrequency    @default(ANNUAL)
  deposit            Float
  gracePeriodDays    Int                 @default(7)
  // Landlord/manager autonomy, not a platform default: 0 means "no late
  // fee" until a rent's owner deliberately sets one. Which of this field
  // vs lateFeeFlatAmount is actually used is decided by lateFeeType.
  lateFeePercentage  Float               @default(0)
  lateFeeFlatAmount  Float               @default(0)
  lateFeeType        LateFeeType         @default(PERCENTAGE)
  signedAgreementUrl String?
  agreementSignedAt  DateTime?
  status             RentStatus          @default(PENDING)
  // PRD §6.1 "Smart Rent Intelligence" — late-payment prediction and risk
  // flagging. Nullable and timestamped: these are computed periodically by a
  // scoring job, not always populated (e.g. a brand-new rent has no payment
  // history yet to score), and the timestamp lets the UI show how stale the
  // score is rather than presenting a silently-outdated number as current.
  paymentReliability PaymentReliability?
  riskScore          RiskLevel?
  riskScoreUpdatedAt DateTime?
  invoices           Invoice[]
  notices            Notice[]
  conversations      Conversation[]
  autoPayMandates    AutoPayMandate[]
  notes              Note[]
  propertyReviews    PropertyReview[]
  // Self-relation: renewedFromId is unique because a given prior rent can be
  // renewed into at most one new rent, and a new rent renews at most one
  // prior rent. Lets renewals be traced instead of looking like an unrelated
  // new Rent row on the same unit.
  renewedFromId      String?             @unique
  renewedFrom        Rent?               @relation("RentRenewal", fields: [renewedFromId], references: [id])
  renewedInto        Rent?               @relation("RentRenewal")
  applications       Application[]
  signatures         RentSignature[]
  agreements         RentAgreement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([unitId, status])
  @@index([tenantId])
}

// PRD §5.1/§5.2's "E-signature support for the rent agreement" -- click-wrap
// style (typed full legal name + timestamp + IP), not a drawn/uploaded
// signature image: there's no file-storage endpoint anywhere in this
// codebase (documented gap, same reason maintenance photo upload is
// display-only), so a real signature *image* isn't buildable yet. A typed
// signature with an audit trail is itself a real, legally-recognized
// e-signature method (same category as clicking "I agree"), not a fake
// stand-in -- same "honest, real, but narrower" principle as ad campaigns'
// zero stats. One row per signer per rent (a rent has at least a tenant
// and a manager/landlord party) -- `@@unique` prevents the same person
// signing twice.
model RentSignature {
  id            String   @id @default(uuid())
  rentId        String
  rent          Rent     @relation(fields: [rentId], references: [id], onDelete: Cascade)
  signerId      String
  signer        User     @relation(fields: [signerId], references: [id])
  signerRole    Role
  fullNameTyped String
  ipAddress     String?
  signedAt      DateTime @default(now())

  @@unique([rentId, signerId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A prospective tenant's rental application for a specific unit —
// PropertyApplicationForm.tsx's ~20-field form (personal/employment/
// references) submits here. Scoped to Unit, not Rent, since an approved
// application still needs a separate, deliberate action to actually create
// the Rent (matches how AddTenantForm's own rent-creation flow works —
// approval doesn't auto-generate a tenancy, a manager still sets terms).
model Application {
  id           String            @id @default(uuid())
  unitId       String
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User              @relation("SubmittedApplications", fields: [applicantId], references: [id])
  status       ApplicationStatus @default(PENDING)
  // Free-form JSON for the form's many fields -- no individual field is
  // queried/filtered on, same precedent as NeighbourhoodReport's and
  // ConditionReport's JSON blobs for this shape of read-mostly data.
  details      Json
  reviewedById String?
  reviewedBy   User?             @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?
  // Set once, at creation time, to the Rent this application resulted in --
  // same "verified at creation, never re-checked" pattern as
  // PropertyReview.rentId (rule 4). Optional: most applications, including
  // every REJECTED one, never produce a rent at all.
  rentId       String?
  rent         Rent?             @relation(fields: [rentId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([unitId, status])
  @@index([applicantId])
}
