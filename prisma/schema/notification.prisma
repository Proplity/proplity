// Covers PRD §5.1 "Automated notifications (email, in-app, push)". In-app
// delivery (this model) and email (lib/email.ts, reused as-is) are covered
// here. Push (browser/mobile) needs VAPID keys + service-worker registration
// this repo doesn't have yet, so it's out of scope for this pass.

enum NotificationType {
  ANNOUNCEMENT
  MAINTENANCE_STATUS
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  // Client-side route to open when the notification is clicked, e.g.
  // "/dashboard/maintenance/<id>" -- not validated against real routes here,
  // callers are responsible for passing a path that exists.
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // (recipientId, createdAt) alone would serve "list mine, newest first";
  // isRead is added because the unread badge count (recipientId, isRead)
  // is queried on every poll tick, i.e. far more often than the full list.
  @@index([recipientId, isRead, createdAt])
}
