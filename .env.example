# ---------------------------------------------------------------------------
# Every variable marked REQUIRED-AT-BUILD must be set in Vercel *before* the
# first deploy, not just at runtime. `next build` runs with NODE_ENV=production,
# and lib/db.ts, lib/auth/jwt.ts and lib/workers/auth.ts each throw at module
# load when their secret is missing under that condition. A missing one fails
# the build, not the request.
# ---------------------------------------------------------------------------

# REQUIRED-AT-BUILD. PostgreSQL connection string used by the running app.
# In production this should be the POOLED endpoint: every serverless
# invocation opens its own pg Pool, and a direct Postgres connection limit
# is exhausted quickly under load.
#   Neon      -> the "-pooler" host from the dashboard
#   Supabase  -> the transaction pooler on port 6543
#   PgBouncer -> the bouncer port, not Postgres' 5432
DATABASE_URL="postgresql://user:password@localhost:5432/proplity?schema=public"

# Optional, but set it in production whenever DATABASE_URL above is pooled.
# `prisma migrate` takes a session-level advisory lock that a transaction-mode
# pooler silently drops, so migrations must use a DIRECT, unpooled connection.
# Read only by prisma.config.ts (CLI work); the app runtime never uses it.
# Leave unset for local dev or any non-pooled Postgres -- it falls back to
# DATABASE_URL.
DIRECT_URL=""

# REQUIRED-AT-BUILD. Generate a strong random value for production:
#   openssl rand -hex 64
# Rotating this invalidates every outstanding access token immediately.
JWT_SECRET="replace_me_with_a_long_random_secret"

# Node environment. Vercel sets this to "production" itself -- do NOT add it
# as a Vercel environment variable.
NODE_ENV="development"

# Public base URL of this deployment, used to build links inside outbound
# email (verification, tenant invites, moderation outcomes). These links were
# previously hardcoded to http://localhost:3000 and broke everywhere else.
#
# Resolution order (lib/appUrl.ts): this var, then Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL (per-deploy, right for
# previews), then localhost. On Vercel it therefore works unset -- but SET IT
# in production anyway: it is the only value that survives a custom domain.
# No trailing slash needed; one is stripped if present.
NEXT_PUBLIC_APP_URL=""

# Paystack secret key -- required for /payments/initialize, /payments/webhook,
# and subscription checkout. Leave unset in dev to get a clean 503 instead of
# a broken payment flow -- or see NEXT_PUBLIC_PAYMENTS_MOCK_ENABLED below for
# a fake checkout that still exercises the real webhook logic.
PAYSTACK_SECRET_KEY=""

# Off by default, and only ever takes effect when PAYSTACK_SECRET_KEY above
# is unset. When "true", a checkout with no real Paystack key gets our own
# fake checkout page (app/dev/mock-checkout) instead of a 503 -- it looks
# like Paystack's hosted page, and "paying" fires a properly-signed fake
# webhook at the real /api/v1/payments/webhook, so the actual Payment/
# invoice/notification logic runs, not a shortcut. Never set this on a real
# deployment with real users.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, so changing
# this in Vercel requires a redeploy to take effect -- not just a restart.
NEXT_PUBLIC_PAYMENTS_MOCK_ENABLED="false"

# Resend API key -- required for real email delivery (verification, password
# reset, tenant invites). Leave unset in dev: lib/email.ts falls back to
# console-transport (logs the email instead of sending it) rather than
# failing, so registration/reset flows still work locally without an
# account. Get a key at https://resend.com.
RESEND_API_KEY=""

# "From" address used when RESEND_API_KEY is set. Must be a verified sender
# (or subdomain) in your Resend account, or delivery will fail. Falls back
# to Resend's own shared onboarding@resend.dev sender if unset -- fine for
# testing, but flagged by spam filters more than a verified domain would be.
EMAIL_FROM="Proplity <onboarding@resend.dev>"

# Cloudinary -- required for real photo/document uploads (maintenance
# request photos, rental application documents). Leave unset in dev: the
# upload UI shows a clear "not available in this environment" state instead
# of silently discarding the file. CLOUDINARY_API_SECRET is used only
# server-side to sign upload requests -- never expose it with a
# NEXT_PUBLIC_ prefix. Get these at https://cloudinary.com (free tier).
# STORAGE_PROVIDER selects where uploads live. One of:
#   cloudinary (default) | s3 | r2 | minio | supabase | imagekit | vercel-blob | local
# No auto-detection and no silent fallback: an unknown value throws, and
# "local" (disk, development only) is refused when NODE_ENV=production.
# Every uploaded file gets a StoredFile row and is read through
# /api/v1/files/<id>, which checks access and serves it from the provider
# recorded on that row -- so changing this later does not strand old files
# (keep the old provider's credentials configured while they exist).
#   cloudinary, s3, r2, minio, supabase: the browser uploads straight to the
#     provider (S3-compatible buckets need a CORS rule allowing PUT from the
#     app origin, and private files are read via short-lived presigned URLs).
#   imagekit, vercel-blob, local: the file goes through POST /api/v1/uploads/file
#     (max UPLOAD_MAX_BYTES, default 4000000 -- Vercel rejects bodies over ~4.5 MB).
# Set NEXT_PUBLIC_STORAGE_ENABLED=true (build time) to enable the upload UI for
# providers other than Cloudinary.
# STORAGE_PROVIDER="cloudinary"
# NEXT_PUBLIC_STORAGE_ENABLED="false"
# UPLOAD_MAX_BYTES="4000000"
# LOCAL_STORAGE_PATH=".local-storage"
#
# s3:          AWS_S3_BUCKET AWS_REGION AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY [AWS_S3_PUBLIC_URL_BASE]
# r2:          R2_ACCOUNT_ID (or R2_ENDPOINT) R2_BUCKET R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY [R2_PUBLIC_URL_BASE]
# minio:       MINIO_ENDPOINT MINIO_BUCKET MINIO_ACCESS_KEY MINIO_SECRET_KEY [MINIO_PUBLIC_URL_BASE]
# supabase:    SUPABASE_URL (or SUPABASE_STORAGE_ENDPOINT) SUPABASE_STORAGE_BUCKET
#              SUPABASE_STORAGE_ACCESS_KEY_ID SUPABASE_STORAGE_SECRET_ACCESS_KEY
# imagekit:    IMAGEKIT_PUBLIC_KEY IMAGEKIT_PRIVATE_KEY IMAGEKIT_URL_ENDPOINT   (unverified)
# vercel-blob: BLOB_READ_WRITE_TOKEN
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Must match CLOUDINARY_CLOUD_NAME and CLOUDINARY_API_KEY above exactly --
# these are the client-safe half of the same credential pair (the upload
# widget in the browser needs them to talk to Cloudinary directly; only the
# API_SECRET above stays server-only). NEXT_PUBLIC_* is inlined into the
# client bundle at BUILD time, so changing these in Vercel requires a
# redeploy to take effect -- not just a restart.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# REQUIRED-AT-BUILD. Shared secret for /api/v1/cron/[job] -- required to
# dispatch any background worker.
#
# On Vercel this name is special: Vercel Cron automatically sends it as
# "Authorization: Bearer <CRON_SECRET>" on every scheduled request, so the
# name must be exactly CRON_SECRET for the schedule in vercel.json to
# authenticate. The route also still accepts "x-cron-secret" for curl/CI.
CRON_SECRET=""

# Real subscription billing kill switch. Unset/anything other than "true"
# means subscriptions are fully disabled: paid-tier CTAs show "Coming Soon",
# checkout redirects away, and the checkout API route itself 503s even if
# called directly. Set to "true" only when ready to actually charge people.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, so changing
# this in Vercel requires a redeploy to take effect -- not just a restart.
NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED="false"

# First-run setup wizard (/setup, POST /api/v1/setup) -- bootstraps the
# platform's first ADMIN account on a fresh database, then self-disables
# permanently once SystemSettings.setupComplete flips to true.

# Optional defense-in-depth: if set, POST /api/v1/setup requires this exact
# value (via the x-setup-token header or the setupToken field) in addition
# to the setupComplete=false guard. Unset means no extra token is required --
# whoever reaches /setup first becomes admin, same as most first-run wizards
# (WordPress, etc). Set this in production if you want to gate that race.
SETUP_TOKEN=""

# Off by default. When "true", /login checks GET /api/v1/setup on mount and
# redirects to /setup if the platform admin hasn't been created yet, so a
# fresh deployer doesn't need to already know the /setup URL. Leave off for
# seeded environments (setupComplete is already true there, so it's a wasted
# request) or if you'd rather hand deployers the /setup URL directly.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, so changing
# this in Vercel requires a redeploy to take effect -- not just a restart.
NEXT_PUBLIC_SETUP_REDIRECT_ENABLED="false"

# Off by default. When "true", a floating "Sent Emails" button appears on
# every page showing every email the app has sent since the server started
# (console-transport or real Resend), so a tester can grab a verification/
# reset/invite link without needing real email delivery. GET/DELETE
# /api/v1/dev/emails are also unauthenticated whenever this is "true" --
# never set this on a real deployment with real users.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, so changing
# this in Vercel requires a redeploy to take effect -- not just a restart.
NEXT_PUBLIC_EMAIL_INBOX_ENABLED="false"

# The AI assistant panel has no backend: it returns canned sample answers (ISS-045).
# It is hidden unless this is "true" at build time, and labelled "Demo only" when shown.
# NEXT_PUBLIC_AI_ASSISTANT_DEMO="false"

# Identity-document retention (ADR-0012). The daily cron job deletes ID documents
# 12 months after a tenancy ends or 90 days after a rejection. Deletion is
# irreversible, so it only runs when this is "true"; otherwise it just reports.
# RETENTION_ENABLED="false"
