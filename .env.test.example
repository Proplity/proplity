# Copy to .env.test (gitignored) for the automated test suite (tests/).
# Points at a SEPARATE database from .env's DATABASE_URL — the test suite
# drops and recreates it on every run, so it must never be the dev database.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proplity_test_db?schema=public"
JWT_SECRET="test_only_jwt_secret_do_not_use_in_production"
CRON_SECRET="test_only_cron_secret_do_not_use_in_production"
NODE_ENV="test"
